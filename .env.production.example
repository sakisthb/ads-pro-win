# Ads Pro — production host env template (Docker + Caddy)
# Copy to `.env` on the deploy host. Never commit real secrets.
#
# DOMAIN = public hostname only (no scheme). Caddy uses it for auto-TLS.
# NEXT_PUBLIC_SITE_URL = https:// same host (OAuth + absolute links).
# Leave SACOS_GROWTH_ORIGIN empty until a real Growth Center HTTPS domain exists.

DOMAIN=YOUR_DOMAIN
NEXT_PUBLIC_SITE_URL=https://YOUR_DOMAIN
NODE_ENV=production

# Supabase (Postgres + Auth)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AES-256-GCM — generate: openssl rand -hex 32
ENCRYPTION_KEY=

# Redis (compose service name on the Docker network)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Rate limiting (Caddy is one trusted hop)
TRUSTED_PROXY_HOPS=1
INTERNAL_RATE_LIMIT_SECRET=
RATE_LIMIT_ENABLED=true

# --- OAuth (register redirects on https://YOUR_DOMAIN) ---
# Google Analytics:  https://YOUR_DOMAIN/api/auth/google-analytics/callback
# Google Search Console: https://YOUR_DOMAIN/api/auth/google-search-console/callback
# Google Ads:        https://YOUR_DOMAIN/api/auth/google-ads/callback
# Meta:              https://YOUR_DOMAIN/api/auth/meta/callback
# Supabase Auth:     Site URL https://YOUR_DOMAIN ; redirect https://YOUR_DOMAIN/auth/callback
#
# No NEXTAUTH_URL — auth is Supabase; public origin is NEXT_PUBLIC_SITE_URL.

GOOGLE_ANALYTICS_CLIENT_ID=
GOOGLE_ANALYTICS_CLIENT_SECRET=
# Optional — empty reuses GOOGLE_ANALYTICS_CLIENT_* for Connect
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
# GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Optional
# TIKTOK_APP_ID=
# TIKTOK_APP_SECRET=

# Growth Center — second hostname later. Keep empty for Ads Pro-only cutover.
SACOS_GROWTH_ORIGIN=
SACOS_GROWTH_DESK_TOKEN=

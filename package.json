    "next-themes": "^0.4.6",
    "node-fetch": "^2.7.0",
    "openai": "^4.104.0",
    "pdfjs-dist": "^5.4.54",
    "postcss": "^8.5.28",
    "prisma": "^6.13.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.61.1",

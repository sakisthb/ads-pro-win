generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("free")
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  campaigns       Campaign[]
  users           User[]
  aiAgents        AIAgent[]
  workflows       Workflow[]
  analyses        Analysis[]
  predictions     Prediction[]
  optimizations   Optimization[]
  apiIntegrations APIIntegration[]
  notifications   Notification[]
  brands          Brand[]
  memberships     OrganizationMembership[]
  alertRules        AlertRule[]
  invitations       Invitation[]
  oauthTransactions OAuthTransaction[]
  webSocketTickets  WebSocketTicket[]

  @@index([createdAt])
  @@index([plan])
  @@map("organizations")
}

model OrganizationMembership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           String       @default("member") // owner, admin, member
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_memberships")
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  fullName    String?
  avatar      String?
  role        String    @default("user") // user, admin, manager
  isActive    Boolean   @default(true)
  lastLoginAt         DateTime?
  onboardingCompleted Boolean @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    OrganizationMembership[]
  campaigns      Campaign[]

  @@index([organizationId])
  @@index([email])
  @@index([isActive])
  @@index([lastLoginAt])
  @@index([organizationId, role]) // Composite index for org+role queries
  @@map("users")
}

model Campaign {
  id             String    @id @default(cuid())
  name           String
  description    String?
  status         String    @default("draft") // draft, active, paused, completed
  platform       String // facebook, google, tiktok, instagram, linkedin
  budget         Float     @default(0)
  budgetSpent    Float     @default(0)
  startDate      DateTime?
  endDate        DateTime?
  targetAudience Json      @default("{}")
  adCreatives    Json      @default("[]")
  performance    Json      @default("{}")
  settings       Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiAgents       AIAgent[]
  workflows      Workflow[]
  analyses       Analysis[]
  predictions    Prediction[]
  optimizations  Optimization[]

  @@index([organizationId])
  @@index([status])
  @@index([platform])
  @@index([startDate])
  @@index([endDate])
  @@index([createdAt])
  @@index([budget])
  @@index([organizationId, status]) // Composite index for org+status queries
  @@index([organizationId, platform]) // Composite index for org+platform queries
  @@map("campaigns")
}

model AIAgent {
  id            String    @id @default(cuid())
  name          String
  type          String // campaign_optimizer, audience_analyzer, creative_generator, performance_predictor
  status        String    @default("active") // active, inactive, training
  configuration Json      @default("{}")
  performance   Json      @default("{}")
  lastRunAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaignId     String?
  campaign       Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([type])
  @@index([status])
  @@index([lastRunAt])
  @@index([organizationId, type]) // Composite index for org+type queries
  @@index([organizationId, status]) // Composite index for org+status queries
  @@map("ai_agents")
}

model Workflow {
  id            String    @id @default(cuid())
  name          String
  description   String?
  type          String // automation, analysis, optimization
  status        String    @default("active") // active, inactive, error
  configuration Json      @default("{}")
  schedule      Json      @default("{}")
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaignId     String?
  campaign       Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([type])
  @@index([status])
  @@index([nextRunAt])
  @@index([lastRunAt])
  @@index([organizationId, type]) // Composite index for org+type queries
  @@index([organizationId, status]) // Composite index for org+status queries
  @@map("workflows")
}

model Analysis {
  id              String   @id @default(cuid())
  type            String // performance, audience, competitive, trend
  title           String
  description     String?
  data            Json     @default("{}")
  insights        Json     @default("[]")
  recommendations Json     @default("[]")
  status          String   @default("completed") // running, completed, failed
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaignId     String?
  campaign       Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([organizationId, type]) // Composite index for org+type queries
  @@index([organizationId, status]) // Composite index for org+status queries
  @@map("analyses")
}

model Prediction {
  id          String   @id @default(cuid())
  type        String // performance, audience, trend, budget
  title       String
  description String?
  data        Json     @default("{}")
  confidence  Float    @default(0)
  accuracy    Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaignId     String?
  campaign       Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([type])
  @@index([confidence])
  @@index([createdAt])
  @@index([organizationId, type]) // Composite index for org+type queries
  @@index([organizationId, confidence]) // Composite index for org+confidence queries
  @@map("predictions")
}

model Optimization {
  id              String   @id @default(cuid())
  type            String // budget, audience, creative, bidding
  title           String
  description     String?
  recommendations Json     @default("[]")
  implementation  Json     @default("{}")
  status          String   @default("pending") // pending, implemented, rejected
  impact          Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaignId     String?
  campaign       Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([organizationId, type]) // Composite index for org+type queries
  @@index([organizationId, status]) // Composite index for org+status queries
  @@map("optimizations")
}

model APIIntegration {
  id          String    @id @default(cuid())
  platform    String // facebook, google, tiktok, instagram, linkedin
  name        String
  status      String    @default("active") // active, inactive, error
  credentials Json      @default("{}")
  settings    Json      @default("{}")
  lastSyncAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([platform])
  @@index([status])
  @@index([lastSyncAt])
  @@index([organizationId, platform]) // Composite index for org+platform queries
  @@index([organizationId, status]) // Composite index for org+status queries
  @@map("api_integrations")
}

model Notification {
  id        String   @id @default(cuid())
  type      String // alert, warning, info, success
  title     String
  message   String
  isRead    Boolean  @default(false)
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
  @@index([organizationId, isRead]) // Composite index for org+isRead queries
  @@map("notifications")
}

// ============================================
// SACOS Marketing OS — New Models
// ============================================

model Brand {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  website        String?
  marketMode     String       @default("inherit") // inherit | mixed | retail | wholesale
  adAccounts     AdAccount[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model AdAccount {
  id           String        @id @default(cuid())
  brandId      String
  brand        Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  platform     String // 'meta' | 'google' | 'tiktok' | 'google-analytics' | 'google-search-console' | commerce/email
  accountId    String // Platform-specific account ID
  name         String
  currency     String        @default("EUR")
  accessToken  String? // Encrypted
  refreshToken String? // Encrypted
  tokenExpiry  DateTime?
  isActive     Boolean       @default(true)
  lastSyncAt   DateTime?
  dailyMetrics DailyMetric[]
  campaigns    AdCampaign[]
  syncJobs     SyncJob[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([platform, accountId])
  @@index([brandId])
  @@index([platform])
}

model DailyMetric {
  id              String    @id @default(cuid())
  date            DateTime  @db.Date
  platform        String
  adAccountId     String
  adAccount       AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  campaignId      String?
  campaignName    String?
  adGroupId       String?
  adId            String?
  currency        String    @default("EUR")
  spend           Decimal   @default(0) @db.Decimal(12, 4)
  impressions     Int       @default(0)
  clicks          Int       @default(0)
  conversions     Decimal   @default(0) @db.Decimal(10, 2)
  conversionValue Decimal   @default(0) @db.Decimal(12, 4)
  reach           Int       @default(0)
  frequency       Decimal?  @db.Decimal(10, 4)
  linkClicks      Int       @default(0)
  landingPageViews Int      @default(0)
  addToCart       Decimal   @default(0) @db.Decimal(10, 2)
  checkouts       Decimal   @default(0) @db.Decimal(10, 2)
  websitePurchases Decimal  @default(0) @db.Decimal(10, 2)
  websitePurchaseValue Decimal @default(0) @db.Decimal(12, 4)
  results         Decimal   @default(0) @db.Decimal(12, 2)
  resultType      String?
  attributionSetting String?
  cpc             Decimal?  @db.Decimal(10, 4)
  cpm             Decimal?  @db.Decimal(10, 4)
  ctr             Decimal?  @db.Decimal(10, 4)
  roas            Decimal?  @db.Decimal(10, 4)
  createdAt       DateTime  @default(now())

  @@unique([date, platform, adAccountId, campaignId, adGroupId, adId])
  @@index([adAccountId, date])
  @@index([date])
  @@index([platform, date])
  @@index([campaignId])
  @@index([platform, adAccountId, date])
}

/// Platform-synced campaign object (Meta / Google / TikTok), separate from
/// app-created `Campaign` rows launched from Campaign Studio.
model AdCampaign {
  id                 String    @id @default(cuid())
  adAccountId        String
  adAccount          AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  platform           String
  platformCampaignId String
  name               String
  status             String    @default("unknown") // active | paused | archived | unknown
  effectiveStatus    String?
  objective          String?
  dailyBudget        Decimal?  @db.Decimal(12, 4)
  lifetimeBudget     Decimal?  @db.Decimal(12, 4)
  budgetType         String? // daily | lifetime | adset
  currency           String    @default("EUR")
  attributionSetting String?
  startTime          DateTime?
  stopTime           DateTime?
  createdTime        DateTime?
  updatedTime        DateTime?
  lastSyncedAt       DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([adAccountId, platformCampaignId])
  @@index([adAccountId, status])
  @@index([platform, platformCampaignId])
}

model WooOrder {
  id            String   @id @default(cuid())
  brandId       String
  orderId       Int // WooCommerce order ID
  orderNumber   String
  status        String // processing, completed, refunded, etc.
  dateCreated   DateTime
  currency      String   @default("EUR")
  grossSales    Decimal  @db.Decimal(12, 4)
  discounts     Decimal  @default(0) @db.Decimal(12, 4)
  refunds       Decimal  @default(0) @db.Decimal(12, 4)
  netSales      Decimal  @db.Decimal(12, 4)
  shipping      Decimal  @default(0) @db.Decimal(10, 4)
  tax           Decimal  @default(0) @db.Decimal(10, 4)
  costOfGoods   Decimal  @default(0) @db.Decimal(12, 4)
  grossProfit   Decimal  @default(0) @db.Decimal(12, 4)
  isNewCustomer Boolean  @default(false)
  customerEmail String?
  source        String? // utm_source or referral
  medium        String? // utm_medium
  campaign      String? // utm_campaign
  market        String   @default("unknown") // retail | wholesale | unknown
  createdAt     DateTime @default(now())

  @@unique([brandId, orderId])
  @@index([brandId, dateCreated])
  @@index([brandId, market, dateCreated])
  @@index([dateCreated])
  @@index([status])
}

model WooProduct {
  id           String    @id @default(cuid())
  brandId      String
  productId    Int // WooCommerce product ID
  sku          String?
  name         String
  price        Decimal   @db.Decimal(10, 4)
  costOfGoods  Decimal   @default(0) @db.Decimal(10, 4)
  stockQty     Int       @default(0)
  stockStatus  String    @default("instock") // instock, outofstock, onbackorder
  isAdvertised Boolean   @default(false)
  lastSyncAt   DateTime?
  soldQty      Int       @default(0)
  soldNet      Decimal   @default(0) @db.Decimal(12, 4)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([brandId, productId])
  @@index([brandId])
  @@index([sku])
  @@index([stockStatus])
}

model SyncJob {
  id               String     @id @default(cuid())
  adAccountId      String?
  adAccount        AdAccount? @relation(fields: [adAccountId], references: [id])
  brandId          String?
  type             String // 'metrics' | 'orders' | 'products'
  platform         String // 'meta' | 'google' | 'tiktok' | 'woocommerce'
  status           String     @default("pending") // pending, running, completed, failed
  startedAt        DateTime?
  completedAt      DateTime?
  error            String?
  recordsProcessed Int        @default(0)
  createdAt        DateTime   @default(now())

  @@index([adAccountId])
  @@index([status])
  @@index([createdAt])
}

model MetaWriteLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  adAccountId    String
  objectType     String
  objectId       String
  action         String
  payload        Json?
  ok             Boolean
  message        String   @db.Text
  learningRisk   Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([adAccountId, createdAt])
  @@index([organizationId, createdAt])
  @@index([objectId, action, createdAt])
}

model AlertRule {
  id              String    @id @default(cuid())
  organizationId  String
  brandId         String?
  platform        String?
  thresholdAmount Decimal   @db.Decimal(12,4)
  period          String    @default("daily")
  isActive        Boolean   @default(true)
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, isActive])
  @@map("alert_rules")
}

model Invitation {
  id              String    @id @default(cuid())
  organizationId  String
  email           String
  role            String    @default("member")
  tokenDigest     String    @unique
  invitedByUserId String
  status          String    @default("pending")
  expiresAt       DateTime
  acceptedAt      DateTime?
  acceptedByUserId String?
  createdAt       DateTime  @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([tokenDigest])
  @@map("invitations")
}

model OAuthTransaction {
  id               String   @id @default(cuid())
  stateDigest      String   @unique
  platform         String
  userId           String
  organizationId   String
  brandId          String?
  returnPath       String   @default("/connections")
  pkceCodeVerifier String?
  consumedAt       DateTime?
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, consumedAt])
  @@index([expiresAt])
  @@index([stateDigest])
  @@map("oauth_transactions")
}

model WebSocketTicket {
  id             String   @id @default(cuid())
  tokenDigest    String   @unique
  userId         String
  organizationId String
  channels       String[]
  consumedAt     DateTime?
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([expiresAt])
  @@index([consumedAt])
  @@map("websocket_tickets")
}

model ApprovalRequest {
  id              String    @id @default(cuid())
  organizationId  String
  requestedBy     String // user ID
  type            String // 'budget_change' | 'campaign_pause' | 'campaign_create'
  platform        String
  accountId       String
  campaignId      String?
  description     String
  currentValue    String? // JSON of current state
  proposedValue   String // JSON of proposed change
  reason          String?
  status          String    @default("pending") // pending, approved, rejected, executed
  approvedBy      String?
  approvedAt      DateTime?
  executedAt      DateTime?
  executionResult String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([organizationId, status])
  @@index([status])
  @@index([createdAt])
}
